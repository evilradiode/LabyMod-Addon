RadioStationRow {
  width: 100%;
  /* Cover 36 + Padding → alles Text/Progress daneben in derselben Höhe */
  height: 44;
  background-color: var(--picker-row-bg);
  background-color-transition-duration: 120;
  border: 1;
  border-color: rgba(255, 255, 255, 0.1);
  padding: 4 6 4 6;
}

RadioStationRow:hover,
RadioStationRow.focused {
  background-color: rgba(220, 40, 40, 0.28);
  border: 1;
  border-color: rgba(255, 80, 80, 0.5);
}

RadioStationRow.playing {
  background-color: rgba(40, 120, 60, 0.2);
  border: 1;
  border-color: rgba(80, 220, 100, 0.55);
}

RadioStationRow.playing:hover,
RadioStationRow.playing.focused {
  background-color: rgba(220, 40, 40, 0.28);
  border: 1;
  border-color: rgba(255, 80, 80, 0.5);
}

RadioStationRow.coming-soon {
  opacity: 0.55;
  height: 28;
}

/* Song-Cover links */
RadioStationRow .row-cover {
  left: 2;
  top: 50%;
  width: 36;
  height: 36;
  alignment-y: center;
  border-radius: 3;
}

/* Sender-Bild rechts neben der Playtime */
RadioStationRow .row-station-icon {
  right: 0;
  top: 50%;
  width: 36;
  height: 36;
  alignment-y: center;
  border-radius: 3;
}

/* Sendername (+ Badges) über Song – neben dem Song-Cover */
RadioStationRow .row-name {
  left: 44;
  top: 1;
  right: 44;
  width: fit-content;
  height: fit-content;
  font-size: 0.55;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-song {
  left: 44;
  top: 11;
  right: 44;
  width: fit-content;
  height: fit-content;
  font-size: 0.55;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-artist {
  left: 44;
  top: 21;
  width: 130;
  height: fit-content;
  font-size: 0.5;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-progress-track {
  left: 44;
  top: 32;
  width: 120;
  height: 2;
  border: 1;
  background-color: rgba(255, 255, 255, 0.12);
  interactable: false;
}

RadioStationRow .row-progress-fill {
  left: 0;
  top: 0;
  height: 2;
  width: var(--row-progress-width);
  background-color: rgba(255, 80, 80, 0.9);
  interactable: false;
}

RadioStationRow.playing .row-progress-fill {
  background-color: rgba(80, 220, 100, 0.9);
}

RadioStationRow .row-time {
  left: 168;
  top: 29;
  width: fit-content;
  height: fit-content;
  font-size: 0.48;
  text-shadow: 0 0 3 rgba(0, 0, 0, 0.85);
  background-color: rgba(0, 0, 0, 0.28);
  border: 1;
  padding: 1 2 2 2;
}

RadioStationRow.coming-soon .row-station-icon {
  left: 2;
  width: 24;
  height: 24;
}

RadioStationRow.coming-soon .row-name {
  left: 32;
  top: 50%;
  width: fit-content;
  alignment-y: center;
  font-size: 0.7;
}
