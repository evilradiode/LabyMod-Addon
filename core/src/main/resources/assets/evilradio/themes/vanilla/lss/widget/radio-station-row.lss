RadioStationRow {
  width: 100%;
  height: 48;
  background-color: var(--picker-row-bg);
  background-color-transition-duration: 120;
  border-radius: 8;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.1);
  padding: 4 6 4 6;
}

RadioStationRow:hover,
RadioStationRow.focused {
  background-color: rgba(220, 40, 40, 0.28);
  border-thickness: 1;
  border-color: rgba(255, 80, 80, 0.5);
}

RadioStationRow.playing {
  background-color: rgba(40, 120, 60, 0.2);
  border-thickness: 1;
  border-color: rgba(80, 220, 100, 0.55);
}

RadioStationRow.playing:hover,
RadioStationRow.playing.focused {
  background-color: rgba(220, 40, 40, 0.28);
  border-thickness: 1;
  border-color: rgba(255, 80, 80, 0.5);
}

RadioStationRow.coming-soon {
  opacity: 0.55;
  height: 28;
}

RadioStationRow .row-station-icon {
  left: 2;
  top: 50%;
  width: 24;
  height: 24;
  alignment-y: center;
  border-radius: 3;
}

RadioStationRow .row-cover {
  left: 30;
  top: 50%;
  width: 36;
  height: 36;
  alignment-y: center;
  border-radius: 3;
}

RadioStationRow .row-name {
  left: 72;
  top: 2;
  width: 175;
  height: fit-content;
  font-size: 0.74;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-song {
  left: 72;
  top: 16;
  width: 175;
  height: fit-content;
  font-size: 0.62;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-artist {
  left: 72;
  top: 28;
  width: 175;
  height: fit-content;
  font-size: 0.58;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

RadioStationRow .row-time {
  right: 4;
  top: 50%;
  width: fit-content;
  height: fit-content;
  alignment-y: center;
  font-size: 0.55;
  text-shadow: 0 0 3 rgba(0, 0, 0, 0.85);
  background-color: rgba(0, 0, 0, 0.28);
  border-radius: 3;
  padding: 1 3 1 3;
}

RadioStationRow.coming-soon .row-name {
  left: 32;
  top: 50%;
  alignment-y: center;
}
