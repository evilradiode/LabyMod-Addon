ModernCurrentSong {
  left: 0;
  top: 0;
  min-width: calc(var(--modern-song-widget-min-width) + 100);
  width: fit-content;
  max-width: var(--modern-song-widget-max-width);
  height: fit-content;
  filter: blur(25);
  border-radius: 15;
  border-thickness: 2;
  border-color: var(--modern-song-widget-border-color);
  background-color: var(--modern-song-widget-bg);
  box-shadow: none;
  orientation: vertical;
  padding-top: 6;
  padding-left: 6;
  padding-right: 6;
  padding-bottom: 6;

  .progress-track {
    border-radius: 5;
    height: 4;
    width: var(--modern-song-widget-progress-max-width);
    margin-top: 4;
    background-color: rgba(255, 255, 255, 0.12);

    .progress-fill {
      top: 0;
      left: 0;
      height: 4;
      width: var(--modern-song-widget-progress-width);
      border-radius: 5;
      background-color: rgba(220, 50, 50, 0.9);
    }

    &.indeterminate {
      .progress-fill {
        opacity: 0.4;
      }
    }
  }

  .content {
    width: fit-content;
    height: fit-content;
    overwrite-width: false;
    orientation: horizontal;
    space-between-entries: 5;

    .cover-stack {
      width: 44;
      height: 44;
      min-width: 44;
      max-width: 44;

      .cover {
        width: 44;
        height: 44;
        border-radius: 10;
        visible: true;
      }

      .station-badge {
        position: absolute;
        left: 1;
        top: 1;
        width: 12;
        height: 12;
        clickable: false;

        .station-icon {
          width: 100%;
          height: 100%;
          border-radius: 3;
          clickable: false;
        }
      }
    }

    .player {
      height: fit-content;
      orientation: vertical;
      width: var(--modern-song-widget-max-width);

      .text {
        height: fit-content;
        orientation: vertical;

        .stream-name, .status, .track, .artist {
          max-lines: 1;
          overflow-strategy: clip;
          width: 100%;
        }
      }
    }
  }

  &.no-cover {
    .cover-stack {
      visible: false;
    }
  }
}
