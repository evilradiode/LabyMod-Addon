ModernCurrentSong {
  left: 0;
  top: 0;
  min-width: var(--modern-song-widget-min-width);
  width: fit-content;
  max-width: var(--modern-song-widget-max-width);
  height: 60;
  filter: blur(25);
  border-radius: 15;
  border-thickness: 2;
  border-color: var(--modern-song-widget-border-color);
  background-color: var(--modern-song-widget-bg);
  box-shadow: none;
  orientation: vertical;

  .progress-track {
    border-radius: 5;
    height: 4;
    width: var(--modern-song-widget-progress-max-width);
    margin-left: 10;
    margin-bottom: 6;
    background-color: rgba(255, 255, 255, 0.12);

    .progress-fill {
      top: 0;
      left: 0;
      height: 4;
      width: var(--modern-song-widget-progress-width);
      border-radius: 5;
      background-color: rgba(220, 50, 50, 0.9);
    }

    &.indeterminate {
      .progress-fill {
        opacity: 0.4;
      }
    }
  }

  .content {
    width: fit-content;
    height: 90%;
    overwrite-width: false;
    margin: 6 0 0 6;
    orientation: horizontal;

    .player {
        height: 100%;
        orientation: vertical;
        width: var(--modern-song-widget-max-width);
        padding-left: 5;

        .text {
          margin-top: 2;
          height: fit-content;
          orientation: vertical;

          .stream-line {
            orientation: horizontal;
            height: 10;
            width: 100%;
            space-between-entries: 4;

            .station-icon {
              width: 10;
              height: 10;
              min-width: 10;
              max-width: 10;
              border-radius: 3;
            }

            .stream-name {
              height: 10;
              width: fit-content;
              max-lines: 1;
              overflow-strategy: clip;
            }
          }

          .status, .track, .artist {
            max-lines: 1;
            overflow-strategy: clip;
            width: 100%;
          }
        }

    }

  }

  .cover {
    width: 44;
    height: 44;
    right: 0;
    top: 0;
    margin-top: 2;
    margin-left: 2;
    border-radius: 10;
    visible: true;
  }

  &.no-cover {
    .cover {
      visible: false;
    }
  }

}
