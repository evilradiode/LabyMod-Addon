ModernCurrentSong {
  left: 0;
  top: 0;
  width: fit-content;
  height: fit-content;

  .song-container {
    left: 0;
    top: 0;
    min-width: 220;
    width: fit-content;
    max-width: 300;
    height: fit-content;
    filter: blur(var(--modern-song-widget-blur));
    border-radius: 10;
    border-thickness: 2;
    border-color: var(--modern-song-widget-border-color);
    background-color: var(--modern-song-widget-bg);
    box-shadow: none;
    orientation: vertical;
  }

  .content {
    width: fit-content;
    max-width: 100%;
    height: fit-content;
    overwrite-width: false;
    margin: 4 8 4 4;
    orientation: horizontal;

    .player {
      height: fit-content;
      orientation: vertical;
      width: var(--modern-song-widget-max-width);
      max-width: 220;
      padding-left: 5;
      padding-right: 2;

      .stream-name {
        max-lines: 1;
        overflow-strategy: clip;
        width: 100%;
      }

      .track {
        margin-top: 2;
        width: 100%;
        height: 9;

        .marquee-label {
          left: 0;
          top: 0;
          max-lines: 1;
          overflow-strategy: clip;
          width: 100%;
        }
      }

      .artist {
        margin-top: 2;
        width: 100%;
        height: 9;

        .marquee-label {
          left: 0;
          top: 0;
          max-lines: 1;
          overflow-strategy: clip;
          width: 100%;
        }
      }

      .progress-row {
        margin-top: 4;
        height: fit-content;
        orientation: horizontal;
        width: 100%;
        alignment-y: center;

        .progress-track {
          margin-top: 1.5;
          border-radius: 5;
          height: 4;
          width: var(--modern-song-widget-progress-max-width);
          background-color: rgba(255, 255, 255, 0.12);

          .progress-fill {
            top: 0;
            left: 0;
            height: 4;
            width: var(--modern-song-widget-progress-width);
            border-radius: 5;
            background-color: var(--modern-song-widget-progress-bar-color);
          }

          &.indeterminate {
            .progress-fill {
              opacity: 0.4;
            }
          }
        }

        .status {
          margin-left: 6;
          font-size: 0.7;
          max-lines: 1;
          overflow-strategy: clip;
        }
      }
    }
  }

  .previous-song-container {
    left: 0;
    top: 0;
    margin-top: 2;
    min-width: 220;
    width: fit-content;
    max-width: 300;
    height: fit-content;
    filter: blur(var(--modern-song-widget-blur));
    border-radius: 10;
    border-thickness: 2;
    border-color: var(--modern-song-widget-border-color);
    background-color: var(--modern-song-widget-bg);
    box-shadow: none;
    orientation: vertical;
    margin-bottom: 2;

    .previous-song-content {
      width: fit-content;
      max-width: 100%;
      height: fit-content;
      overwrite-width: false;
      margin: 4 4 4 4;
      orientation: horizontal;

      .previous-song-cover {
        width: 20;
        height: 20;
        right: 0;
        top: 0;
        margin: 1 0 0 2;
        border-radius: 5;
        visible: true;
      }

      .previous-player {
        height: fit-content;
        orientation: vertical;
        width: var(--modern-song-widget-max-width);
        max-width: 220;
        padding-left: 5;
        padding-right: 2;

        .previous-song-label {
          width: 100%;
          font-size: 0.8;
          text-color: gray;
          margin-bottom: 2;
        }

        .previous-song-artist {
          width: 100%;
          height: fit-content;

          .marquee-label {
            left: 0;
            top: 0;
            max-lines: 1;
            overflow-strategy: clip;
            width: 100%;
            font-size: 0.7;
          }
        }

        .previous-song-track {
          width: 100%;
          height: fit-content;

          .marquee-label {
            left: 0;
            top: 0;
            max-lines: 1;
            font-size: 0.7;
            overflow-strategy: clip;
            width: 100%;
            font-size: 0.7;
          }
        }

      }

    }

  }

  .cover {
    width: 44;
    height: 44;
    right: 0;
    top: 0;
    margin-top: 0;
    margin-left: 2;
    border-radius: 10;
    visible: true;
  }

  &.no-cover {
    .cover {
      visible: false;
    }
  }

}
