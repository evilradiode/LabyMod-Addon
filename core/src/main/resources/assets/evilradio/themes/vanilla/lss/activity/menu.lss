  .player-restore {
    bottom: 48;
    width: 32;
    height: 32;
    padding: 3;
    background-color: rgba(20, 20, 20, 180);
    border: 1;
    border-color: rgba(125, 125, 125, 50);
    priority-layer: very_front;
    interactable: true;
    alignment-y: bottom;
    object-fit: contain;
  }

  .player-restore.right {
    right: 8;
  }

  .player-restore.left {
    left: 8;
  }

  .song-container.right {
    right: 8;
  }

  .song-container.left {
    left: 8;
  }

  .player-restore:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .song-container {
    bottom: 48;
    width: 132;
    height: fit-content;
    priority-layer: very_front;
    background-color: rgba(20, 20, 20, 180);
    border: 1;
    border-color: rgba(125, 125, 125, 50);
    box-shadow: none;
    orientation: vertical;
    alignment-y: bottom;

    .player-chrome {
      left: 100%;
      alignment-x: right;
      width: fit-content;
      height: 16;
      margin: 4 4 0 0;
      space-between-entries: 2;
    }

    .player-settings {
      width: 12;
      height: 12;
      padding: 0;
      font-size: 0.7;
      text-align: center;
      text-color: rgb(230, 230, 230);
      background-color: rgba(100, 100, 100, 180);
      border: 1;
      border-color: rgba(125, 125, 125, 50);

      Icon {
        width: 8;
        height: 8;
      }

    }

    .player-move {
      width: 16;
      height: 16;
      padding: 0;
      font-size: 0.7;
      text-align: center;
      text-color: rgb(230, 230, 230);
      background-color: rgba(180, 190, 90, 180);
      border: 1;
      border-color: rgba(125, 125, 125, 50);

      Icon {
        width: 10;
        height: 10;
      }

    }

    .player-move .button-text {
      padding-right: 2;
    }

    .player-close {
      width: 16;
      height: 16;
      padding: 0;
      font-size: 0.7;
      text-align: center;
      text-color: rgb(255, 220, 220);
      background-color: rgba(180, 40, 40, 180);
      border: 1;
      border-color: rgba(125, 125, 125, 50);

      Icon {
        width: 10;
        height: 10;
      }

    }

    .player-close .button-text {
      padding-right: 1;
    }

    .mashup-live-banner {
      width: 100%;
      height: 0;
      margin: 0;
      padding: 0;
      background-color: rgba(220, 40, 40, 0.28);
      border: 0;
      border-color: rgba(255, 90, 90, 0.55);
      orientation: vertical;
      alignment-x: center;
      interactable: true;
      priority-layer: very_front;

      .mashup-live-title {
        width: 100%;
        height: fit-content;
        max-lines: 1;
        font-size: 0.6;
        alignment-x: center;
        scroll-text: false;

        Component {
          alignment-x: center;
        }
      }

      .mashup-live-detail {
        margin-top: 1;
        width: 100%;
        height: fit-content;
        max-lines: 3;
        font-size: 0.6;
        alignment-x: center;
        scroll-text: false;

        Component {
          alignment-x: center;
        }
      }
    }

    .mashup-live-banner.switch {
      height: fit-content;
      margin: 4 4 0 4;
      padding: 4 5 4 5;
      border: 1;
    }

    .mashup-live-banner.switch:hover {
      background-color: rgba(220, 50, 50, 0.42);
    }

    .mashup-live-banner.upcoming {
      height: fit-content;
      margin: 4 4 0 4;
      padding: 4 5 4 5;
      border: 1;
    }

    .mashup-live-banner.actions {
      height: fit-content;
      margin: 4 4 0 4;
      padding: 4 4 4 4;
      border: 1;
      background-color: rgba(220, 40, 40, 0.18);
    }

    .mashup-live-actions {
      left: 50%;
      alignment-x: center;
      margin-top: 3;
      width: fit-content;
      height: 14;
      space-between-entries: 2;
    }

    .mashup-live-grussbox {
      width: 50;
      height: 14;
      padding: 0;
      font-size: 0.52;
      text-align: center;
      background-color: rgba(180, 30, 30, 0.55);
      border: 1;
      border-color: rgba(255, 90, 90, 0.55);
      interactable: true;
    }

    .mashup-live-grussbox .button-text {
      padding: 0;
    }

    .mashup-live-grussbox.alone {
      width: 100%;
    }

    .mashup-live-grussbox:hover {
      background-color: rgba(220, 50, 50, 0.75);
    }

    .mashup-live-twitch {
      width: 50;
      height: 14;
      padding: 0;
      font-size: 0.52;
      text-align: center;
      background-color: rgba(100, 50, 180, 0.4);
      border: 1;
      border-color: rgba(145, 70, 255, 0.55);
      interactable: true;
    }

    .mashup-live-twitch .button-text {
      padding: 0;
    }

    .mashup-live-twitch.alone {
      width: 100%;
    }

    .mashup-live-twitch:hover {
      background-color: rgba(145, 70, 255, 0.65);
    }

    .content {
      width: 100%;
      height: fit-content;
      overwrite-width: false;
      margin: 5;
      orientation: vertical;
      alignment-x: center;

      .cover {
        left: 50%;
        width: 56;
        height: 56;
        alignment-x: center;
        margin-bottom: 3;
        border-radius: 10;
        visible: true;
      }

      .player {
        width: 100%;
        height: fit-content;
        orientation: vertical;

        .stream-name {
          width: 100%;
          height: 10;
          max-lines: 1;
          overflow-strategy: clip;
          alignment-x: center;

          Component {
            alignment-x: center;
          }
        }

        .live-status {
          height: 0;
          margin: 0;
          width: 100%;
          max-lines: 1;
          overflow-strategy: clip;
        }

        .live-status.active {
          margin-top: 2;
          width: 100%;
          height: 10;

          Component {
            alignment-x: center;
          }
        }

        .track {
          alignment-x: center;
          margin-top: 2;
          width: 100%;
          height: 10;
          max-lines: 1;
          overflow-strategy: clip;
          scroll-text: true;
          scroll-mode: loop;
          scroll-speed: 10.0;
          scroll-gap: 25.0;

          Component {
            alignment-x: center;
          }
        }

        .track.idle {
          height: fit-content;
          max-lines: 2;
          scroll-text: false;
        }

        .artist {
          alignment-x: center;
          margin-top: 2;
          width: 100%;
          height: 10;
          max-lines: 1;
          overflow-strategy: clip;
          scroll-text: true;
          scroll-mode: loop;
          scroll-speed: 10.0;
          scroll-gap: 25.0;

          Component {
            alignment-x: center;
          }
        }

        .stream-name.hidden {
          height: 0;
          margin: 0;
        }

        .artist.hidden {
          height: 0;
          margin: 0;
        }

        .progress-row.hidden {
          height: 0;
          margin: 0;
        }

        .progress-row {
          margin-top: 3;
          width: 100%;
          height: fit-content;
          orientation: vertical;
          alignment-x: center;

          .progress-track {
            width: 100%;
            height: 4;
            border: 1;
            background-color: rgba(255, 255, 255, 0.12);
            interactable: false;

            .progress-fill {
              top: 0;
              left: 0;
              height: 4;
              width: var(--menu-song-progress-width);
              background-color: rgb(255, 85, 85);
            }

            &.indeterminate {
              .progress-fill {
                opacity: 0.4;
              }
            }
          }

          .status {
            left: 50%;
            alignment-x: center;
            margin-top: 2;
            width: fit-content;
            max-width: 100%;
            height: 8;
            max-lines: 1;
            font-size: 0.65;
            overflow-strategy: clip;

            Component {
              alignment-x: center;
            }
          }
        }
      }
    }

    .controls {
      margin-top: 3;
      left: 50%;
      width: fit-content;
      height: fit-content;
      alignment-x: center;
      space-between-entries: 6;

      .previous {
        height: 12;
        width: 12;

        Icon {
          width: 8;
          height: 8;
        }

      }

      .play-pause {
        height: 12;
        width: 12;

        Icon {
          width: 8;
          height: 8;
          padding-left: 2;
        }

      }

      .next {
        height: 12;
        width: 12;

        Icon {
          width: 8;
          height: 8;
        }

      }
    }

    .station-picker {
      margin-top: 3;
      width: 100%;
      height: 14;
      padding: 0;
      font-size: 0.65;
      text-align: center;
      background-color: rgba(255, 255, 255, 180);
      border: 1;
      border-color: rgba(255, 255, 255, 0.12);
    }

    .volume-slider {
      margin-top: 4;
      width: 100%;
      height: 10;

      Component {
        padding-top: 0.5;
        font-size: 0.8;
      }

    }
  }