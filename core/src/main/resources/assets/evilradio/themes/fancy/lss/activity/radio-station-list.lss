@keyframes picker-open {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.picker-panel {
  left: 50%;
  top: 50%;
  width: 320;
  height: fit-content;
  alignment-x: center;
  alignment-y: center;
  background-color: var(--picker-panel-bg);
  filter: blur(var(--picker-panel-blur));
  border-radius: 12;
  border-thickness: 1;
  border-color: var(--picker-panel-border);
  padding: 10 12 10 12;
  space-between-entries: 7;
  animation-duration: 180;
}

.picker-header {
  width: 100%;
  height: 30;
}

.picker-logo {
  left: 0;
  top: 50%;
  width: 28;
  height: 28;
  alignment-y: center;
  border-radius: 4;
}

.picker-title {
  left: 50%;
  width: fit-content;
  height: fit-content;
  alignment-x: center;
  alignment-y: center;
  font-size: 1.05;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.85);
}

.picker-close-x {
  right: 4;
  top: 50%;
  width: 16;
  height: 16;
  alignment-y: center;
  background-color: rgba(180, 40, 40, 0.45);
  border-radius: 4;
  border-thickness: 1;
  border-color: rgba(255, 90, 90, 0.55);
  text-align: center;
}

/* Text sitzt als Kind .button-text – Padding schrumpft nur die Box */
.picker-close-x .button-text {
  margin-right: 1.5;
}

.picker-close-x:hover {
  background-color: rgba(220, 50, 50, 0.75);
}

.picker-tabs {
  width: 100%;
  height: 22;
  layout: spread;
}

.picker-tab {
  top: 0;
  width: 140;
  height: 20;
  padding: 0;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 6;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.12);
  text-align: center;
  font-size: 0.65;
}

.picker-tab:hover {
  background-color: rgba(255, 255, 255, 0.12);
}

.picker-tab.active {
  background-color: rgba(230, 126, 34, 0.55);
  border-color: rgba(230, 126, 34, 0.85);
}

.picker-now-playing {
  width: 100%;
  height: 85;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 8;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.12);
  padding: 4;
}

.picker-eq {
  left: 34;
  width: 254;
  bottom: 33;
  opacity: 0.45;
  interactable: false;
}

.picker-now-playing.no-eq .picker-eq {
  right: 26;
}

.picker-eq-bar {
  left: var(--eq-bar-left);
  width: 3;
  height: var(--eq-bar-height);
  bottom: var(--eq-bar-bottom);
  border-radius: 1;
  background-color: rgba(255, 70, 70, 0.9);
  interactable: false;
}

.picker-eq-peak {
  left: var(--eq-bar-left);
  width: 3;
  height: 2;
  bottom: var(--eq-peak-bottom);
  border-radius: 0;
  background-color: rgba(255, 220, 120, 0.95);
  opacity: 0;
  interactable: false;
}

.picker-eq.eq-peaks .picker-eq-peak {
  opacity: 1;
}

.picker-eq.eq-peaks .picker-eq-bar {
  background-color: rgba(80, 220, 120, 0.9);
}

.picker-eq.eq-mirror .picker-eq-bar {
  background-color: rgba(90, 180, 255, 0.9);
}

.picker-eq.eq-scope .picker-eq-bar {
  background-color: rgba(120, 255, 180, 0.95);
}

.picker-eq.eq-dots .picker-eq-bar {
  border-radius: 1.5;
  background-color: rgba(255, 160, 60, 0.95);
}

.picker-cover {
  left: 0;
  top: 0;
  width: 28;
  height: 28;
  border-radius: 4;
}

.picker-cover-texts {
  left: 34;
  top: 0;
  /* gleiche Breite wie Volume-Slider */
  width: 240;
  height: fit-content;
  space-between-entries: 1;
  padding: 3 7 3 7;
  background-color: rgba(0, 0, 0, 0.62);
  border-radius: 4;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.1);
  interactable: false;
}

.picker-now-playing.no-eq .picker-cover-texts {
  width: 230;
}

.picker-cover-station {
  width: 100%;
  height: fit-content;
  font-size: 0.7;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 0 0 5 rgba(0, 0, 0, 1);
}

.picker-cover-song {
  width: 100%;
  height: fit-content;
  font-size: 0.62;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 0 0 5 rgba(0, 0, 0, 1);
}

.picker-cover-artist {
  width: 100%;
  height: fit-content;
  font-size: 0.55;
  max-lines: 1;
  overflow-strategy: clip;
  text-shadow: 0 0 5 rgba(0, 0, 0, 1);
}

.picker-cover-progress-track {
  left: 34;
  bottom: 28;
  width: 215;
  height: 2;
  border-radius: 1;
  background-color: rgba(255, 255, 255, 0.14);
  interactable: false;
}

.picker-now-playing.no-eq .picker-cover-progress-track {
  width: 170;
}

.picker-cover-progress-fill {
  left: 0;
  top: 0;
  height: 2;
  width: var(--picker-progress-width);
  border-radius: 1;
  background-color: rgba(255, 80, 80, 0.95);
  interactable: false;
}

/* Zeit auf Höhe der Progressbar */
.picker-cover-time {
  right: 24;
  bottom: 25;
  width: fit-content;
  height: fit-content;
  font-size: 0.48;
  text-shadow: 0 0 3 rgba(0, 0, 0, 0.85);
  background-color: rgba(0, 0, 0, 0.28);
  border-radius: 3;
  padding: 1 2 2 2;
  interactable: false;
}

.picker-now-playing.no-eq .picker-cover-time {
  left: 208;
}

.picker-eq-toggle {
  right: 0;
  top: 22;
  width: 20;
  height: 20;
  padding: 0 0 0 1;
  background-color: rgba(255, 70, 70, 0.4);
  border-radius: 4;
  border-thickness: 1;
  border-color: rgba(255, 120, 120, 0.55);
  text-align: center;
  font-size: 0.55;

  Icon {
    height: 14;
    width: 14;
    margin: 0 1 0 0;
  }

}

.picker-eq-toggle:hover {
  background-color: rgba(255, 70, 70, 0.65);
}

.picker-eq-toggle.off {
  background-color: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.18);
  opacity: 0.7;
}

.picker-eq-toggle.off:hover {
  background-color: rgba(255, 255, 255, 0.14);
  opacity: 1;
}

.picker-play-pause {
  right: 0;
  top: 0;
  width: 20;
  height: 20;
  padding: 0 0 0 1;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 4;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.2);
  text-align: center;

  Icon {
    margin: 0 0 0 1;
  }

}

.picker-play-pause:hover {
  background-color: rgba(255, 255, 255, 0.18);
}

.picker-audio-eq-volume-container {
  left: 0;
  bottom: 0;
  right: 0;
  height: fit-content;
  layout: fill;
}

.picker-audio-eq-preset-container {
  top: 0;
  height: fit-content;
  width: fit-content;
}

.picker-audio-eq-preset-title {
  top: 0;
  left: 0;
  font-size: 0.6;
}

.picker-audio-eq-settings-container {
  top: 0;
  height: fit-content;
  space-between-entries: 2;
}

.picker-audio-eq-settings {
  width: 16;
  height: 16;
}

.picker-audio-eq-preset {
  top: 0;
  left: 0;
  height: 16;
}

/* Gleiche Breite/Position wie .picker-cover-texts */
.picker-volume-slider {
  height: 16;
  margin: 8 2 0 -18;
}

.picker-now-playing.no-eq .picker-volume-slider {
  width: 230;
}

.station-scroll {
  width: 100%;
  height: var(--station-scroll-height);
}

.station-scroll Scrollbar {
  use-lss-position: true;
  right: 0;
  top: 3;
  bottom: 3;
  width: 4;
  margin-left: 8;
}

.station-list {
  width: 100%;
  height: fit-content;
  space-between-entries: 3;
}

.schedule-panel {
  width: 100%;
  height: fit-content;
  space-between-entries: 8;
}

.schedule-day-chips {
  width: 100%;
  height: 24;
  layout: spread;
}

.schedule-day-chip {
  width: fit-content;
  height: 22;
  padding: 2 4 1 3;
  background-color: rgba(255, 255, 255, 0.06);
  border-radius: 4;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.12);
  max-lines: 2;
  overflow-strategy: clip;
}

/* Button-Text sitzt sonst zu weit oben */
.schedule-day-chip .button-text {
  margin: 6 0 0 0;
  left: 0;
  width: fit-content;
  text-align: center;
}

.schedule-day-chip:hover {
  background-color: rgba(255, 255, 255, 0.12);
}

.schedule-day-chip.active {
  background-color: rgba(230, 126, 34, 0.55);
  border-color: rgba(230, 126, 34, 0.85);
}

.schedule-scroll {
  width: 100%;
  height: var(--schedule-scroll-height);
}

.schedule-scroll Scrollbar {
  use-lss-position: true;
  right: 0;
  top: 3;
  bottom: 3;
  width: 4;
  margin-left: 8;
}

.schedule-list {
  width: 100%;
  height: fit-content;
  space-between-entries: 6;
}

.schedule-day-header {
  width: 100%;
  height: fit-content;
  font-size: 0.75;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.85);
}

.schedule-empty-box {
  width: 100%;
  height: 60;
  background-color: rgba(255, 255, 255, 0.04);
  border-radius: 6;
  border-thickness: 1;
  border-color: rgba(255, 255, 255, 0.1);
}

.schedule-empty {
  left: 50%;
  top: 50%;
  width: fit-content;
  height: fit-content;
  alignment-x: center;
  alignment-y: center;
  font-size: 0.75;
  text-shadow: 1 1 2 rgba(0, 0, 0, 0.75);
}

