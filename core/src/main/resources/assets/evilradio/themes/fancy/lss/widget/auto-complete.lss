AutoComplete {
  height: fit-content;
  width: 80%;
  margin: 3 0 1 3;
  padding: 2 0 2 3;
  border-radius: 5;
  border-color: rgba(20, 20, 20, 1.0);
  background-color: rgba(10, 10, 10, 1.0);

  .autocomplete-content {
    height: fit-content;
    width: 100%;

    .autocomplete-icon {
      height: 16;
      width: 16;
      border-radius: 3;
    }

    .autocomplete-text {
      height: fit-content;
      width: fit-content;

      Component {
        font-size: 0.8;
      }

      .autocomplete-title-details {
        font-size: 0.6;
      }

    }

    .autocomplete-preview-button {
      width: 14;
      height: 14;
      margin-right: 3;
    }

  }

}

AutoComplete:hover {
  background-color: rgba(220, 40, 40, 0.28);
  border-thickness: 1;
  border-color: rgba(255, 80, 80, 0.5);
}